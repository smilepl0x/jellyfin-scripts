# Shared configuration for download-playlist scripts
# Both PowerShell and Bash scripts read from this file

# Output
OUTPUT_TEMPLATE=%(playlist_title)s/%(playlist_index)s - %(title)s.%(ext)s
ARCHIVE_FILENAME=downloaded.txt

# Audio
DEFAULT_AUDIO_FORMAT=mp3
AUDIO_QUALITY=0
LOUDNORM_I_AUDIO=-16
LOUDNORM_TP_AUDIO=-1.5
LOUDNORM_LRA=11
LOUDNORM_I_VIDEO=-14
LOUDNORM_TP_VIDEO=-1.0

# Video
MAX_HEIGHT=1080

# Features
DEFAULT_BROWSER=firefox
SPONSORBLOCK_CATEGORIES=all
# Note: On re-runs of already-downloaded files, SponsorBlock may report
# "Cannot cut video since the real and expected durations mismatch." This is a
# known yt-dlp limitation (#3846) when a file was already cut in a prior run.
# It is non-destructive: --ignore-errors skips it and the existing file is kept.

# Rate limiting / politeness (passed to yt-dlp)
# SLEEP_REQUESTS is the fixed wait between info requests (min for random sleep)
SLEEP_REQUESTS=3
# SLEEP_INTERVAL is the base wait between downloads (acts as the minimum)
SLEEP_INTERVAL=5
# MAX_SLEEP_INTERVAL randomizes the sleep to a value in [SLEEP_INTERVAL, MAX]
# Set to the same value as SLEEP_INTERVAL to disable randomization
MAX_SLEEP_INTERVAL=25
# Retries on transient errors (HTTP 429/5xx)
RETRIES=10
FRAGMENT_RETRIES=10
# Exponential backoff sleep between retries (exp=START:CAP:BASE)
RETRY_SLEEP=exp=1:180:2
# Optional bandwidth cap, e.g. 2M for 2 MB/s (empty = unlimited)
LIMIT_RATE=
